{
  "manifest_version": 3,
  "name": "Log Jammer — Kibana Bridge",
  "version": "0.1.0",
  "description": "Capture Kibana Discover queries and feed log data to Log Jammer",
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*.druidplatform.com/*",
    "https://logjammer.mltru.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://*.druidplatform.com/*"],
      "js": ["page-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost/*", "https://*.druidplatform.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Log Jammer Kibana Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
